{"data": [{"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2026-03-03T13:47:00.896000+00:00", "deleted": null, "description": "A Elei\u00e7\u00e3o para o Presidente da Rep\u00fablica em 2026 realizou-se entre 18 de janeiro e 15 de fevereiro. O Arquivo.pt recolheu 2.3 Terabytes de conte\u00fados eleitorais e disponibiliza agora o conjunto de dados relativos a todo o processo, tais como termos de pesquisa, conte\u00fados identificados e conte\u00fados arquivados.\n\nNeste conjunto encontra os seguintes dados:\n- lista de termos de pesquisa\n- resultados da pesquisa antes da 1\u00aa volta das elei\u00e7\u00f5es\n- resultados da pesquisa depois 1\u00aa volta das elei\u00e7\u00f5es\n- resultados da pesquisa antes da 2\u00aa volta das elei\u00e7\u00f5es\n- resultados da pesquisa depois da 2\u00aa volta das elei\u00e7\u00f5es\n- resultados da pesquisa depois da 2\u00aa volta, segundo turno\n\nMais informa\u00e7\u00e3o: https://sobre.arquivo.pt/pt/recolha-especial-de-conteudos-web-sobre-as-eleicoes-presidenciais-precisamos-da-sua-ajuda/\n", "description_short": null, "extras": {}, "featured": false, "frequency": "punctual", "frequency_date": null, "harvest": null, "id": "69a6e6546a846050ae84d5b1", "internal": {"created_at_internal": "2026-03-03T13:47:00.896000+00:00", "last_modified_internal": "2026-03-13T11:03:04.205000+00:00"}, "last_modified": "2026-03-13T11:03:04.205000+00:00", "last_update": "2026-03-13T11:03:04.195000+00:00", "license": "cc-by", "license_title": "Creative Commons Attribution 4.0 - CC BY 4.0", "metrics": {"dataservices": 1, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0}, "resources_downloads": 330, "reuses": 0, "reuses_by_months": {"2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0}, "views": 759}, "organization": {"acronym": "Arquivo.pt", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "6087fbf7454ae34be8d6ce4e", "logo": "https://dados.gov.pt/s/avatars/4d/371c6f310f45da9542656aa55361cb-original.png", "logo_thumbnail": "https://dados.gov.pt/s/avatars/4d/371c6f310f45da9542656aa55361cb-100.png", "name": "Arquivo.pt - pesquise p\u00e1ginas do passado", "page": "https://dados.gov.pt/organizations/arquivo-pt-pesquise-paginas-do-passado", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "arquivo-pt-pesquise-paginas-do-passado", "uri": "https://dados.gov.pt/api/1/organizations/arquivo-pt-pesquise-paginas-do-passado/"}, "owner": null, "page": "https://dados.gov.pt/datasets/eleicoes-presidenciais-2026-lista-de-paginas-web-com-conteudos-eleitorais-para-preservacao-no-arquivo-pt", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": true, "dataset_description_quality": true, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 1.0, "spatial": true, "temporal_coverage": true, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": {"type": "sha1", "value": "02d9c4fc770c6068bc99505f3dbb7b293a549e62"}, "created_at": "2026-03-03T14:45:45.590000+00:00", "description": "Este documento identifica os Websites oficiais e as redes sociais utilizadas pelos candidatos \u00e0s Elei\u00e7\u00f5es Presidenciais 2026. \nA captura e reprodu\u00e7\u00e3o de conte\u00fados das redes sociais no formato arquivo da Web tem limita\u00e7\u00f5es impostas pelas plataformas. \nAssim, \u00e9 necess\u00e1rio moderar as expectativas em rela\u00e7\u00e3o ao que se consegue obter. \nPor outro lado, incentiva-se os gestores e criadores de conte\u00fado a publicarem os mesmos conte\u00fados (uma vez que s\u00e3o p\u00fablicos) num local aberto, como por exemplo numa sec\u00e7\u00e3o do Website. Esta estrat\u00e9gia \u00e9 \u00fatil do ponto de vista da preserva\u00e7\u00e3o dos conte\u00fados produzidos, pois facilita o acesso do Arquivo.pt, al\u00e9m de manter uma vers\u00e3o p\u00fablica do lado de quem os produziu.", "extras": {"analysis:check_id": 103183, "analysis:checksum": "02d9c4fc770c6068bc99505f3dbb7b293a549e62", "analysis:content-length": 14331, "analysis:last-modified-at": "2026-03-03T14:45:43+00:00", "analysis:last-modified-detection": "last-modified-header", "analysis:mime-type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "analysis:parsing:finished_at": "2026-11-12T18:18:49.116286+00:00", "analysis:parsing:parsing_table": "921d4f7493922437008e7c293746ac1d", "analysis:parsing:started_at": "2026-11-12T18:18:48.905027+00:00", "check:available": true, "check:cors:status": 200, "check:date": "2026-11-14T18:20:13.498215+00:00", "check:headers:content-length": 14331, "check:headers:content-type": "", "check:id": 144376, "check:status": 200, "check:timeout": false}, "filesize": 14331, "filetype": "file", "format": "xlsx", "harvest": null, "id": "cab4f663-3245-4162-ada6-096fd596d560", "internal": {"created_at_internal": "2026-03-03T14:45:45.590000+00:00", "last_modified_internal": "2026-03-03T16:48:45.809000+00:00"}, "last_modified": "2026-03-03T16:48:45.809000+00:00", "latest": "https://dados.gov.pt/api/1/datasets/r/cab4f663-3245-4162-ada6-096fd596d560", "metrics": {"views": 24}, "mime": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "preview_url": "http://localhost:7000/resources/cab4f663-3245-4162-ada6-096fd596d560", "schema": null, "title": "websites-e-canais-oficiais-dos-candidatos-eleicoes-presidenciais-2026.xlsx", "type": "main", "url": "https://dados.gov.pt/s/resources/eleicoes-presidenciais-2026-lista-de-paginas-web-com-conteudos-eleitorais-para-preservacao-no-arquivo-pt/20260303-144545/websites-e-canais-oficiais-dos-candidatos-eleicoes-presidenciais-2026.xlsx"}, {"checksum": {"type": "sha1", "value": "a76162a20211d5fc2af4037ec1218677aa15f63f"}, "created_at": "2026-03-03T15:14:19.161000+00:00", "description": "Este documento cont\u00e9m os termos de pesquisa utilizados para inserir num motor de busca e obter resultados acerca das Elei\u00e7\u00f5es Presidenciais 2026.\nO objetivo da lista de termos \u00e9 cobrir os diversos aspetos das elei\u00e7\u00f5es, utilizando para isso alguns temas relacionados com a vida social, pol\u00edtica e econ\u00f3mica, em geral, nomes dos candidados, nomes dos partidos, nomes de cidades e unidades terrritoriais de Portugal e ainda nomes de meios de comunica\u00e7\u00e3o social. A lista de termos \u00e9 semelhante \u00e0 utilizada em eventos eleitorais anteriores e \u00e9 apenas um instrumento de descoberto, sendo adaptada sempre que \u00e9 necess\u00e1rio, algumas vezes enquanto se faziam as pesquisas. Por exemplo, acrescentou-se \"\"Portugal\"\" em algumas pesquisas para refor\u00e7ar que se procurava conte\u00fados das elei\u00e7\u00f5es portuguesas e n\u00e3o das elei\u00e7\u00f5es brasileiras de outubro de 2026.", "extras": {"analysis:check_id": 141817, "analysis:checksum": "a76162a20211d5fc2af4037ec1218677aa15f63f", "analysis:content-length": 35218, "analysis:last-modified-at": "2026-03-03T15:14:17+00:00", "analysis:last-modified-detection": "last-modified-header", "analysis:mime-type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "analysis:parsing:finished_at": "2026-11-14T08:11:33.683538+00:00", "analysis:parsing:parsing_table": "610a6298a7430837f1f679bc92438839", "analysis:parsing:started_at": "2026-11-14T08:11:33.349487+00:00", "check:available": false, "check:cors